<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings> 
		<!-- Onde você realmente quer que os binários sejam gerados -->
		<OutputPath>C:\MIDP_MIPS\libcs</OutputPath>

		<!-- Evita que o BaseOutputPath seja combinado com subpastas -->
		<BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>

		<!-- Remove criação da pasta Debug/Release -->
		<UseCommonOutputDirectory>true</UseCommonOutputDirectory>

		<!-- Remove criação da pasta com o nome do TargetFramework -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- Remove criação da pasta da configuração (Debug/Release) -->
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
		<Platforms>AnyCPU;x64</Platforms>
		<AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
		<ApplicationIcon>cpu.ico</ApplicationIcon>
		<StartupObject>MIDP.Program</StartupObject>

		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<CopyBuildOutputDirectory>true</CopyBuildOutputDirectory>
		<CopyOutputSymbolsDirectory>true</CopyOutputSymbolsDirectory>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="cpu.ico" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MIPS.Compiler\MIPS.Compiler.csproj" />
    <ProjectReference Include="..\MIPS.DeviceLib\MIPS.DeviceLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>